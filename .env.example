# Copia este archivo como .env.local y completa los valores reales:
#   cp .env.example .env.local
#
# Se obtienen en el dashboard de Supabase: Settings > API.
# NUNCA subas .env.local a GitHub (ya está en .gitignore).

# URL de tu proyecto de Supabase (ej: https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública "anon" de Supabase. Es pública por diseño: la seguridad la da el RLS de la tabla.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
